# ============================================
# Sanna CRM - Environment Configuration
# ============================================
# Copy this file to .env and update values
# cp .env.example .env

# ---- Database ----
POSTGRES_USER=sanna
POSTGRES_PASSWORD=sanna_dev_2024
POSTGRES_DB=sanna_crm
DB_PORT=5432

# ---- Backend ----
DATABASE_URL=postgresql+asyncpg://sanna:sanna_dev_2024@db:5432/sanna_crm
DATABASE_URL_SYNC=postgresql://sanna:sanna_dev_2024@db:5432/sanna_crm
BACKEND_PORT=8000
APP_ENV=development

# ---- Authentication ----
JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# ---- Frontend ----
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# ---- Nginx ----
NGINX_PORT=80

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ---- File Storage ----
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
